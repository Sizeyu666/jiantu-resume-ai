/* pages/index/index.wxss V3 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.status-bar { background: var(--bg); flex-shrink: 0; }

/* ---------- 顶部品牌区 ---------- */
.hero {
  padding: 26rpx 8rpx 28rpx;
}
.hero-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--primary);
  letter-spacing: 2rpx;
  line-height: 1.2;
}
.hero-slogan {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  letter-spacing: 1rpx;
}

/* ---------- 加载 ---------- */
.loading-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

/* ---------- 列表 ---------- */
.list { flex: 1; }
.list-inner { padding: 0 24rpx; }
.card-hover { opacity: 0.82; }

.resume-card { margin-bottom: 20rpx; }
.resume-title {
  font-size: 32rpx;
  font-weight: 600;
  max-width: 560rpx;
}
.more {
  padding: 0 16rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-sub);
  line-height: 1;
}
.progress-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.progress-track {
  flex: 1;
  height: 8rpx;
  background: #eef0f3;
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}
.progress-num {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  min-width: 64rpx;
  text-align: right;
}
.resume-time {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-placeholder);
}

/* ---------- 区块标题（右侧操作按钮） ---------- */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0 20rpx;
}
.tpl-section-head { margin-top: 40rpx; }
.section-title { font-size: 34rpx; font-weight: 700; color: var(--text-main); }
.section-more { font-size: 24rpx; color: var(--primary); }

.head-actions { display: flex; align-items: center; gap: 14rpx; }
.head-btn {
  display: flex;
  align-items: center;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1;
}
.head-btn-icon { font-size: 24rpx; margin-right: 4rpx; }
.head-btn-plus { font-size: 30rpx; line-height: 1; margin-right: 2rpx; margin-top: -2rpx; }
.head-btn-primary {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}
.head-btn-ghost {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  font-weight: 500;
}
.head-btn-hover { opacity: 0.75; }

/* ---------- 内嵌空状态 ---------- */
.empty-block {
  background: #fff;
  border-radius: var(--radius);
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-card);
}
.empty-block .empty-icon { font-size: 88rpx; }
.empty-block .empty-text {
  margin: 18rpx 0 28rpx;
  font-size: 25rpx;
  color: var(--text-sub);
  text-align: center;
  line-height: 1.6;
}
.empty-block .empty-btn { width: 100%; }

/* ---------- 模板 3 列网格 ---------- */
.tpl-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.tpl-card {
  width: calc((100% - 32rpx) / 3);
  margin-bottom: 22rpx;
}
.tpl-mini {
  position: relative;
  width: 100%;
  height: 268rpx;
  background: #fff;
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  box-sizing: border-box;
  padding: 20rpx 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
}
.tpl-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-main);
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 缩略图骨架线 */
.sk { background: #e6e9ee; border-radius: 2rpx; }
.sk-title {
  width: 48%;
  height: 12rpx;
  background: var(--c);
  margin-bottom: 16rpx;
}
.sk-l1 { width: 100%; height: 8rpx; margin-bottom: 10rpx; }
.sk-l2 { width: 86%; height: 8rpx; margin-bottom: 10rpx; }
.sk-l3 { width: 92%; height: 8rpx; }

/* A1 经典灰条：灰色块标题 */
.m-gray-block .sk-title {
  width: 100%;
  height: 26rpx;
  border-radius: 3rpx;
}
/* A2 深蓝标题：标题下横线 */
.m-left-ul { border-top: 6rpx solid var(--c); padding-top: 26rpx; }
/* A3 极简黑白：黑标题 + 黑线 */
.m-bw-en .sk-title { background: #111; width: 62%; height: 10rpx; }
.m-bw-en { border-top: 4rpx solid #111; padding-top: 24rpx; }
/* A4 左竖线 */
.m-left-bar { box-shadow: inset 8rpx 0 0 var(--c); padding-left: 20rpx; }
/* A5 信息表格 */
.m-info-table { padding: 14rpx; }
.m-info-table .sk-title { width: 38%; height: 14rpx; }
.m-info-table::after {
  content: '';
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  top: 62rpx;
  height: 120rpx;
  background-image:
    linear-gradient(to right, #d9dce1 1rpx, transparent 1rpx),
    linear-gradient(to bottom, #d9dce1 1rpx, transparent 1rpx);
  background-size: 50% 100%, 100% 33.33%;
  pointer-events: none;
}
/* B1/B2/B4/B5 深色侧栏 */
.m-side-dark::before,
.m-side-light::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 32%;
}
.m-side-dark::before { background: var(--c); }
.m-side-light::before {
  background: #f1f3f6;
  border-right: 2rpx solid var(--border);
}
.m-side-dark .sk,
.m-side-light .sk { margin-left: calc(32% + 14rpx); }
.m-side-dark .sk-title { width: 44%; }
.m-side-dark .sk { background: #d7dbe2; }

/* ---------- AI 证件照小入口 ---------- */
.idphoto-entry {
  margin-top: 6rpx;
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow-card);
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
}
.idphoto-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: var(--primary-50);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.idphoto-main { flex: 1; margin-left: 22rpx; }
.idphoto-name { font-size: 28rpx; font-weight: 600; color: var(--text-main); }
.idphoto-desc { margin-top: 6rpx; font-size: 22rpx; color: var(--text-sub); }
.idphoto-arrow { font-size: 40rpx; color: var(--text-placeholder); line-height: 1; }

/* ---------- 导入弹窗 ---------- */
.import-modal { width: 640rpx; padding-bottom: 0; }
.import-tip {
  font-size: 23rpx;
  color: var(--text-sub);
  line-height: 1.6;
  margin-top: 20rpx;
}
.import-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 260rpx;
  max-height: 480rpx;
  margin: 24rpx 0 8rpx;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
}
.modal-btn-disabled { opacity: 0.5; }
.import-ways {
  display: flex;
  padding: 20rpx 0 28rpx;
  gap: 20rpx;
}
.import-way-item {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-sub);
  background: var(--bg);
  border-radius: 12rpx;
  padding: 18rpx 0;
}
.import-way-disabled { opacity: 0.45; pointer-events: none; }

/* ---------- 弹窗 ---------- */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx 0;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}
.modal-input {
  margin: 32rpx 0;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}
.modal-btns {
  display: flex;
  border-top: 2rpx solid var(--border);
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: var(--text-sub);
}
.modal-btn-primary {
  color: var(--primary);
  font-weight: 600;
  border-left: 2rpx solid var(--border);
}
