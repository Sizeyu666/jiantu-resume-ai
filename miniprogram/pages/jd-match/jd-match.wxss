/* pages/jd-match/jd-match.wxss */
.page { padding: 24rpx 24rpx 60rpx; }

/* 免费体验提示 */
.trial-hint {
  margin-top: 18rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-placeholder, #909399);
}
.trial-link { color: #c0392b; }

/* ============ 会员拦截（旧整页拦截，已改为按次体验，样式保留备用） ============ */
.gate {
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 56rpx 0;
  text-align: center;
}
.gate-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(30, 58, 95, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}
.gate-title { font-size: 36rpx; font-weight: 700; margin-top: 32rpx; }
.gate-desc { font-size: 26rpx; color: var(--text-sub); line-height: 1.7; margin-top: 20rpx; }
.gate-features { margin-top: 36rpx; align-self: stretch; }
.gate-feat {
  font-size: 26rpx;
  color: var(--text-main);
  background: var(--card-bg);
  border-radius: 12rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 16rpx;
  text-align: left;
}
.gate-btn { margin-top: 40rpx; width: 100%; }

/* ============ 简历选择 ============ */
.resume-pick {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.rp-left { display: flex; align-items: center; min-width: 0; }
.rp-label { font-size: 24rpx; color: var(--text-sub); margin-right: 20rpx; flex-shrink: 0; }
.rp-title { font-size: 28rpx; font-weight: 600; max-width: 380rpx; }
.rp-caret { font-size: 24rpx; color: var(--primary); flex-shrink: 0; }
.empty-hint { font-size: 24rpx; color: var(--text-sub); padding: 20rpx 8rpx; }
.empty-link { color: var(--primary); }

/* ============ 分段切换 ============ */
.seg {
  display: flex;
  background: #e9ebef;
  border-radius: 999rpx;
  padding: 6rpx;
  margin: 24rpx 0;
}
.seg-item {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: var(--text-sub);
  padding: 16rpx 0;
  border-radius: 999rpx;
}
.seg-active { background: #ffffff; color: var(--primary); font-weight: 700; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08); }

/* ============ 卡片 ============ */
.card {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.card-title { font-size: 30rpx; font-weight: 700; margin-bottom: 20rpx; }
.jd-input {
  width: 100%;
  min-height: 240rpx;
  background: #f6f7f9;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 27rpx;
  line-height: 1.6;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

/* ============ 分数圆环 ============ */
.score-card { display: flex; align-items: center; }
.score-ring-wrap { position: relative; width: 200rpx; height: 200rpx; flex-shrink: 0; }
.score-ring { width: 200rpx; height: 200rpx; }
.score-ring-center {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.score-num { font-size: 60rpx; font-weight: 700; line-height: 1.1; }
.score-unit-text { font-size: 20rpx; color: var(--text-placeholder); margin-top: 2rpx; }
.score-info { flex: 1; padding-left: 36rpx; }
.score-summary { font-size: 26rpx; color: var(--text-sub); line-height: 1.6; }

/* ============ 技能对照表 ============ */
.skill-row { padding: 18rpx 0; border-top: 2rpx solid #f0f1f3; }
.skill-row:first-of-type { border-top: none; padding-top: 0; }
.skill-top { display: flex; align-items: center; }
.skill-mark { font-size: 28rpx; margin-right: 12rpx; }
.skill-name { font-size: 27rpx; font-weight: 600; flex: 1; }
.skill-conf { display: flex; }
.conf-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #e5e7eb;
  margin-left: 6rpx;
}
.conf-dot.conf-on { background: #f59e0b; }
.skill-sug { font-size: 24rpx; color: var(--text-sub); line-height: 1.6; margin-top: 10rpx; padding-left: 40rpx; }

/* ============ 缺失关键词 ============ */
.kw-wrap { display: flex; flex-wrap: wrap; }
.kw-chip {
  font-size: 24rpx;
  color: #ef4444;
  background: rgba(239, 68, 68, 0.08);
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
  margin: 0 14rpx 14rpx 0;
}
.kw-tip { font-size: 22rpx; color: var(--text-placeholder); line-height: 1.6; }

/* ============ ATS ============ */
.ats-line { font-size: 27rpx; font-weight: 600; }
.ats-ok { color: #10b981; }
.ats-bad { color: #f59e0b; }
.ats-warn { font-size: 24rpx; color: var(--text-sub); line-height: 1.7; margin-top: 10rpx; }

/* ============ 体检 ============ */
.check-intro .check-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  margin: -8rpx 0 24rpx;
}
.check-item {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.ci-head { display: flex; align-items: center; margin-bottom: 14rpx; }
.ci-badge {
  font-size: 22rpx;
  color: #ffffff;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.ci-red { background: #ef4444; }
.ci-yellow { background: #f59e0b; }
.ci-green { background: #10b981; }
.ci-name { font-size: 28rpx; font-weight: 700; }
.ci-detail { font-size: 26rpx; line-height: 1.7; color: var(--text-main); }
.ci-sug {
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.7;
  margin-top: 8rpx;
  padding-left: 8rpx;
}
.ci-sug-arrow { color: var(--primary); margin-right: 8rpx; }
