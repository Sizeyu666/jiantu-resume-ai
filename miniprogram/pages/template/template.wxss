/* pages/template/template.wxss 模板广场 V3：3 列 + 分类筛选 */
.page {
  height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 0;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.header { padding: 12rpx 8rpx 18rpx; flex-shrink: 0; }
.header-title { font-size: 40rpx; font-weight: 800; color: var(--text-main); }
.header-sub { font-size: 23rpx; color: var(--text-sub); margin-top: 8rpx; }

/* ---------- 分类筛选 ---------- */
.cat-bar {
  flex-shrink: 0;
  white-space: nowrap;
  padding: 4rpx 0 18rpx;
}
.cat-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  font-size: 25rpx;
  color: var(--text-sub);
  background: #fff;
  border-radius: 999rpx;
  border: 2rpx solid var(--border);
}
.cat-item-on {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  font-weight: 600;
}

.tpl-scroll { flex: 1; }

/* ---------- 三列卡片网格 ---------- */
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.tpl-card {
  width: 222rpx;
  background: #fff;
  border-radius: 14rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
  margin-bottom: 22rpx;
}
.card-hover { opacity: 0.8; }

/* 缩略图：内宽 202rpx，缩放比 202/750 ≈ 0.2693，高 1059*0.2693 ≈ 285rpx */
.thumb {
  position: relative;
  width: 202rpx;
  height: 285rpx;
  margin: 10rpx auto 0;
  overflow: hidden;
  border-radius: 4rpx;
  background: #ffffff;
  border: 1rpx solid var(--border);
}
.thumb-scale {
  width: 750rpx;
  transform: scale(0.2693);
  transform-origin: top left;
}

/* ---------- 文案 ---------- */
.tpl-info { padding: 12rpx 12rpx 14rpx; }
.tpl-name { font-size: 22rpx; font-weight: 700; color: var(--text-main); text-align: center; }
.tpl-desc {
  font-size: 18rpx;
  color: var(--text-placeholder);
  margin-top: 6rpx;
  line-height: 1.4;
  text-align: center;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 50rpx;
}

.bottom-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-placeholder);
  padding: 12rpx 0 40rpx;
}
