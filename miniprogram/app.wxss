/** app.wxss 全局样式：V2 设计令牌 + 通用类
 * 配色：深蓝 #1e3a5f 专业可信 / 底 #f8fafc / 会员金 #d4a017
 * 简历模板内样式由 resume-render 组件独立管理，不受全局令牌影响
 **/
page {
  /* ---------- 品牌色 ---------- */
  --primary: #1e3a5f;
  --primary-dark: #16293f;
  --primary-light: #2b4f7e;
  --primary-50: #eef2f7;
  --gold: #d4a017;
  --gold-50: #fbf3dc;

  /* ---------- 功能色 ---------- */
  --success: #10b981;
  --warning: #f59e0b;
  --danger: #ef4444;

  /* ---------- 中性色 ---------- */
  --bg: #f8fafc;
  --card-bg: #ffffff;
  --text-main: #1f2937;
  --text-sub: #6b7280;
  --text-placeholder: #9ca3af;
  --border: #e5e7eb;
  --divider: #eef0f3;

  /* ---------- 圆角 / 阴影 ---------- */
  --radius: 20rpx;
  --radius-sm: 12rpx;
  --shadow-card: 0 4rpx 24rpx rgba(30, 58, 95, 0.06);
  --shadow-float: 0 8rpx 32rpx rgba(30, 58, 95, 0.12);

  background: var(--bg);
  color: var(--text-main);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, "Microsoft YaHei", sans-serif;
  line-height: 1.5;
}

/* ---------- 通用布局 ---------- */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; min-width: 0; }
.safe-bottom { padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom); }

/* ---------- 卡片 ---------- */
.card {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  margin: 0;
  line-height: 1.4;
  transition: transform 0.12s ease, opacity 0.12s ease;
}
.btn::after { border: none; }
.btn-primary { background: var(--primary); color: #fff; box-shadow: 0 6rpx 18rpx rgba(30, 58, 95, 0.22); }
.btn-primary.btn-hover,
.btn-primary:active { background: var(--primary-dark); transform: scale(0.985); }
.btn-gold { background: linear-gradient(135deg, #e6b530, var(--gold)); color: #fff; box-shadow: 0 6rpx 18rpx rgba(212, 160, 23, 0.28); }
.btn-gold.btn-hover,
.btn-gold:active { transform: scale(0.985); }
.btn-ghost { background: #fff; color: var(--primary); border: 2rpx solid var(--primary); }
.btn-ghost:active { background: var(--primary-50); }
.btn-danger-ghost { background: #fff; color: var(--danger); border: 2rpx solid var(--danger); }
.btn[disabled] { background: #cdd3db !important; color: #fff !important; box-shadow: none; }
.btn-sm { font-size: 24rpx; padding: 10rpx 32rpx; }

/* ---------- 文本 ---------- */
.text-sub { color: var(--text-sub); font-size: 24rpx; }
.text-placeholder { color: var(--text-placeholder); }
.text-danger { color: var(--danger); }
.text-warning { color: var(--warning); }
.text-success { color: var(--success); }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* ---------- AI 合规提示（所有 AI 内容下方必须展示） ---------- */
.ai-disclaimer {
  font-size: 22rpx;
  color: var(--text-placeholder);
  text-align: center;
  padding: 16rpx 0 8rpx;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-50);
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  margin: 0 12rpx 12rpx 0;
}

/* ---------- 分割线 ---------- */
.hairline { height: 2rpx; background: var(--border); transform: scaleY(0.5); }

/* ---------- 底部弹层通用 ---------- */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.4);
  z-index: 20;
}

/* ---------- 空状态通用 ---------- */
.empty-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 40rpx;
}
.empty-block .empty-icon { font-size: 88rpx; line-height: 1; }
.empty-block .empty-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--text-placeholder);
  text-align: center;
}
